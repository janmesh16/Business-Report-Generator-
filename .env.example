# Ledgerly Environment Configuration

# Server Port
PORT=3001

# Client URL (for CORS and PDF generation)
CLIENT_URL=http://localhost:5173

# LLM Provider Configuration
# Options: 'mock' (default, requires no key) or 'gemini'
LLM_PROVIDER=mock

# Gemini API Key (required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Gemini Model Name (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database File Path (defaults to server/ledgerly.db)
DATABASE_PATH=./ledgerly.db

# Max upload limit in bytes (10MB)
MAX_FILE_SIZE=10485760

